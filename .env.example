# Copy to .env.local for local dev, and set the same values in Vercel
# (Project → Settings → Environment Variables) for the deployed build.

# Production origin, no trailing slash, e.g. https://calunsag.dev
# Used by server invitations/chat and at build time to stamp canonical,
# og:url, absolute social images, and sitemap.xml. On Vercel this falls
# back to VERCEL_PROJECT_PRODUCTION_URL automatically, so it is optional
# there; set it explicitly once a custom domain is attached. Unset means
# relative social images, which means LinkedIn and Facebook render no
# preview card at all.
SITE_URL=

# Server-only password hash. Never use a VITE_ prefix for passwords or keys.
# Generate a long unique password and its SHA-256 digest with /admin setup.
ADMIN_PASSWORD_HASH=

# Blue chatbot with Gemini-selected meme reactions. Key from aistudio.google.com/apikey.
# Without it the assistant button never renders at all.
GEMINI_API_KEY=
# Optional — pin a model. Defaults to gemini-3.8-flash.
GEMINI_MODEL=

# Spotify profile popover, "Now Playing" status chip, and "On Repeat" panel
# (top tracks + recently played) on About's Now page. All three are
# required for playback. Run npm run spotify:connect to authorize locally.
# See docs/spotify-setup.md for deployment. api/spotify.ts documents the
# one-time authorization that produces the refresh token. Authorize with
#   user-read-currently-playing user-read-recently-played user-top-read
# — a token with only the first scope keeps the chip but not the panel.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# GitHub panel on the Now tab. Works with no token at all — that path uses
# the public events feed, which GitHub caps at 90 days, and the heatmap is
# captioned as recent activity rather than contributions.
# Set a token (classic, no scopes needed for public data) to get the real
# 12-month contribution calendar and a 5,000/hr rate limit instead of 60.
GITHUB_TOKEN=
# Defaults to tengkyuuu.
GITHUB_USERNAME=

# Invitation emails (Admin > Invitations). Never prefix these with VITE_.
# Verify a domain you own in Resend before sending to other recipients.
# Gmail is supported as Reply-To, but cannot be the Resend sender.
RESEND_API_KEY=
RESEND_FROM=
RESEND_REPLY_TO=jamescalunsag13@gmail.com
# SITE_URL above should be https://engrjamescalunsag.vercel.app
