{
  "name": "jvc-portfolio",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run postbuild",
    "postbuild": "node scripts/collect-metrics.mjs && node scripts/emit-content-defaults.mjs",
