{
  "name": "jvc-portfolio",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "spotify:connect": "node scripts/connect-spotify.mjs",
    "build": "tsc -b && vite build && npm run postbuild",
    "postbuild": "node scripts/apply-seo.mjs && node scripts/collect-metrics.mjs && node scripts/emit-content-defaults.mjs",
    "preview": "vite preview",
    "start": "node server/index.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "security:check": "npm audit --audit-level=moderate && node scripts/check-security.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@supabase/supabase-js": "^2.108.1",
    "@types/three": "^0.184.1",
    "express": "^5.2.1",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^0.469.0",
    "motion": "^11.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^24.19.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vercel/node": "^16.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^29.1.1",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@vercel/node": {
      "path-to-regexp": "^6.3.0",
      "undici": "^6.29.0"
    },
    "@vercel/static-config": {
      "ajv": "^8.20.0"
    },
    "tsx": {
      "esbuild": "^0.28.2"
    }
  }
}
