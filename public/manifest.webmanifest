{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "name": "Portfolio.docx — James Vincent Calunsag",
  "short_name": "Portfolio.docx",
  "description": "Computer Engineer working at the seam of embedded, frontend, and design.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#e6e6e6",
  "theme_color": "#2b579a",
  "lang": "en",
  "categories": ["productivity", "portfolio"],
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Projects",
      "url": "/#work",
      "icons": [{ "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml" }]
    },
    {
      "name": "Résumé",
      "url": "/resume",
      "icons": [{ "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml" }]
    },
    {
      "name": "Contact",
      "url": "/#contact",
      "icons": [{ "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml" }]
    }
  ]
}
