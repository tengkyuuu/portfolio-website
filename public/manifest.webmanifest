{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "name": "Portfolio.docx — James Vincent Calunsag",
  "short_name": "Portfolio.docx",
  "description": "AI-driven computer engineer focused on full-stack development and design.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#e6e6e6",
  "theme_color": "#2b579a",
  "lang": "en",
  "categories": [
    "productivity",
    "portfolio"
  ],
  "icons": [
    {
      "src": "/icon-192.png?v=2",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png?v=2",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512.png?v=2",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Projects",
      "url": "/#work",
      "icons": [
        {
          "src": "/icon-192.png?v=2",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Résumé",
      "url": "/resume",
      "icons": [
        {
          "src": "/icon-192.png?v=2",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Contact",
      "url": "/#contact",
      "icons": [
        {
          "src": "/icon-192.png?v=2",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
